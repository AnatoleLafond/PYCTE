@primary_entity(E, pe, 7.0, lin, 0.1, literbulk, 0.01)
@entity(Fe, tot, 0)
@primary_entity(Fe, -9.0, literbulk, 0.01)
@Global: pH
@Calc:(1, "H.logact = -pH")
@entity(H, tot, 0)
@primary_entity(H, pH, 7.0, lin, 0.1, literbulk, 0.01)
@entity(K, tot, 0)
@primary_entity(K, -9.0, literbulk, 0.01)
@entity(Mg, tot, 0)
