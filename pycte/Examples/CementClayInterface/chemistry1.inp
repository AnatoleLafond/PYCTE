@primary_entity(O, H2O.logact, -0.0)
@entity(S, tot, 0)
@primary_entity(S, -9.0, literbulk, 0.01)
@entity(Si, tot, 0)
@primary_entity(Si, -9.0, literbulk, 0.01)
@entity(Sr, tot, 0)
@primary_entity(Sr, -9.0, literbulk, 0.01)
