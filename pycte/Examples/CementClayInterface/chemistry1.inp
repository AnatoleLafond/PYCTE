//*********  Version: 05 March 2026 9:43  *******
@NrDigits: 12  // number of decimal places in reaction coefficients. 
 //@rewriteReactions:   //indicates that reactions are rewritten in terms of primary entities. 
 //@include_molar_volume_parameters:   //include molar volume parameters from phreeqc database in species definitions. 

//********* The database file(s) *******
// This section lists the database files that are used by the interactive chemistry editor
// The database file is not used during the calculations!
// Syntax for local files:                   @database: minteq.txt
// Syntax for files on the internet:         @database: www.meeussen.nl/orchestra/minteqv4.txt

@database: PHREEQC_Davies_e-_ThermoChimie_v12a.dat
//********* End of the database file(s) *******


//********* Extra text 0 *******

@class: extra_text_0(){

@Calc: (1,  "watervolume = porosity * totvolume * saturation")     // is total water volume per cell
@Calc: (1,  "gasvolume   = porosity * (1-saturation)")             // is tot gas volume per liter water
@Calc: (1,  "SL = ((1-porosity)*density) / (porosity*saturation)")


//@writeExpandedText:
}
@extra_text_0()
//********* End of extra text 0 *******


//********* The variables *******
@Var: CLAY_kgkg 0 // fraction clay of clay particle
@Var: DFA_kgl 0 // concentration of DFA
@Var: DHA_kgl 0 // concentration of DHA
@Var: E.logact 1 // **
@Var: Goethite_kgkg 0 // fraction goethite of goethite particle
@Var: H+.logact 1 // **
@Var: H.logact 1 // auto generated **
@Var: H2O.logact 0 // 
@Var: HFO_kgkg 0 // fraction hfo of hfo particle
@GlobalVar: I .1 // 
@Var: O.logact 0 // **
@Var: SFA_kgkg 0 // fraction FA of FA particle
@Var: SHA_kgkg 0 // fraction HA of HA particle
@Var: SL 1 // 
@Var: T 298.15 // 
@Var: density 1 // 
@Var: gasvolume 1 // gas filled volume (Liter gas/Liter pore solution
@Var: pH -0.8450980400142568 // 
@Var: pe -1.0791812460476249 // 
@Var: porosity 1 // 
@Var: saturation 1 // 
@Var: totvolume 1 // 
@Var: watervolume 1 // 
//********* End of the variables *******


//********* Extra text 1 *******
@class: extra_text_1(){

}
@extra_text_1()
//********* End of extra text 1 *******

//********* The phases *******
@phase(tot)
@phase(literbulk)
@link_phase(literbulk, tot, "totvolume")
@phase(solid)
@link_phase(solid, literbulk, "1")
@phase(min)
@link_phase(min, solid, "1")
@phase(ads)
@link_phase(ads, solid, "1")
@phase(CLAY_part_l)
@link_phase(CLAY_part_l, ads, "1")
@phase(CLAY_part)
@link_phase(CLAY_part, CLAY_part_l, "CLAY_kgkg*SL")
@phase(HFO_part_l)
@link_phase(HFO_part_l, ads, "1")
@phase(HFO_part)
@link_phase(HFO_part, HFO_part_l, "HFO_kgkg*SL")
@phase(Goethite_part_l)
@link_phase(Goethite_part_l, ads, "1")
@phase(Goethite_part)
@link_phase(Goethite_part, Goethite_part_l, "Goethite_kgkg*SL")
@phase(SHA_part_l)
@link_phase(SHA_part_l, ads, "1")
@phase(SFA_part_l)
@link_phase(SFA_part_l, ads, "1")
@phase(kg)
@phase(liter)
@link_phase(liter, literbulk, "porosity")
@link_phase(liter, kg, "1/SL")
@phase(solution)
@link_phase(solution, liter, "1")
@phase(diss)
@link_phase(diss, solution, "1")
@phase(colloid)
@link_phase(colloid, solution, "1")
@phase(DHA_part)
@link_phase(DHA_part, colloid, "1")
@phase(HA_part)
@link_phase(HA_part, DHA_part, "DHA_kgl")
@link_phase(HA_part, SHA_part_l, "SHA_kgkg*SL")
@phase(DFA_part)
@link_phase(DFA_part, colloid, "1")
@phase(FA_part)
@link_phase(FA_part, DFA_part, "DFA_kgl")
@link_phase(FA_part, SFA_part_l, "SFA_kgkg*SL")
@phase(gas_l)
@link_phase(gas_l, liter, "1")
@phase(gas)
@link_phase(gas, gas_l, "gasvolume/22.4")
@end_of_gui_phases:
//********* End of the phases *******

//********* Extra text 2 *******
@class: extra_text_2(){
   @scan: objects2026.txt
}
@extra_text_2()
//********* End of extra text 2 *******

@davies()
@calculate_water_activity()

//********* The primary entities *******
@entity(Tracer, tot, 0)
@primary_entity(Tracer, -9.0, literbulk, 0.01)
@entity(Al, tot, 0)
@primary_entity(Al, -9.0, literbulk, 0.01)
@entity(C, tot, 0)
@primary_entity(C, -9.0, literbulk, 0.01)
