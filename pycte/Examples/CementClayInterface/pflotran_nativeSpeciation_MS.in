# == discretization (meshing of pycte : 15 + 35 + 10 + 30 cells, 10.3 m) ======
GRID
  TYPE STRUCTURED
  NXYZ 90 1 1
  DXYZ
    15*0.02d0 35*0.04285714285714286 10*0.1d0 30*0.25d0
    1.d0
    1.d0
  /
END
# == fluid properties =========================================================
FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 1e-09
END
# == material properties ======================================================
MATERIAL_PROPERTY cement
  ID 1
  POROSITY 0.13
  TORTUOSITY 0.0338
  LONGITUDINAL_DISPERSIVITY 0.d0
END
MATERIAL_PROPERTY clay
  ID 2
  POROSITY 0.18
  TORTUOSITY 0.144
  LONGITUDINAL_DISPERSIVITY 0.d0
END
# == output ===================================================================
OUTPUT
  TIMES y 1
  FORMAT HDF5
END
# == times (end time and output time rewritten by pycte at every coupling step) =
TIME
  FINAL_TIME 1 y
  INITIAL_TIMESTEP_SIZE 1.d-3 y
  MAXIMUM_TIMESTEP_SIZE 0.02 y
END
# == regions ==================================================================
REGION all
  COORDINATES
    -1.d20 -1.d20 -1.d20
    1.d20 1.d20 1.d20
  /
END
REGION cement
  BLOCK 1 15 1 1 1 1
END
REGION clay
  BLOCK 16 90 1 1 1 1
END
REGION east
  FACE EAST
  COORDINATES
    10.3d0 0.d0 0.d0
    10.3d0 1.d0 1.d0
  /
END
# == transport conditions =====================================================
TRANSPORT_CONDITION Initial
  TYPE DIRICHLET
  CONSTRAINT_LIST
    0.d0 Initial
  /
END
TRANSPORT_CONDITION east
  TYPE DIRICHLET
  CONSTRAINT_LIST
    0.d0 Clay
  /
END
# == couplers =================================================================
INITIAL_CONDITION Initial
  TRANSPORT_CONDITION Initial
  REGION all
END
BOUNDARY_CONDITION east
  TRANSPORT_CONDITION east
  REGION east
END
# == stratigraphy =============================================================
STRATA
  MATERIAL cement
  REGION cement
END
STRATA
  MATERIAL clay
  REGION clay
END
# == constraints : initial state written by pycte in testpycte.h5 (<name>i) ===
