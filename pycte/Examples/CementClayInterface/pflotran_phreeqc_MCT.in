# Cement / clay interface benchmark, PhreeqC, multi-compound transport (totals) : PFLOTRAN transports, pycte computes the chemistry.
# Every transported column of pycte is a neutral tracer <name>pycte of pflotranDB.txt (no reaction, no activity).
# A column that can be negative is split : <name>pycte (positive part) and <name>_negpycte (negative part).
# Pore diffusion coefficient = DIFFUSION_COEFFICIENT * TORTUOSITY : cement 3.38e-11, clay 1.44e-10 m2/s.
# x = 0 closed (no flux), x = 10.3 m : clay water (Dirichlet, constraint Clay = secondBoundary of pycte).
SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_TRANSPORT transport
      MODE GIRT
    /
  /
END
SUBSURFACE
# == numerical methods ========================================================
NUMERICAL_METHODS TRANSPORT
  TIMESTEPPER
    TS_ACCELERATION 8
    MAX_STEPS 100000
  /
  NEWTON_SOLVER
    PRECONDITIONER_MATRIX_TYPE AIJ
    RTOL 1.d-10
    ATOL 1.d-50
    STOL 1.d-12
  /
  LINEAR_SOLVER
    SOLVER DIRECT
  /
END
SPECIFIED_VELOCITY
  UNIFORM? YES
  DATASET 0.d0 0.d0 0.d0 m/s
END
# == chemistry ================================================================
CHEMISTRY
  PRIMARY_SPECIES
    Alpycte
    C(+4)pycte
    C(-4)pycte
    Capycte
    Clpycte
    Fe(+2)pycte
    Fe(+3)pycte
    Kpycte
    Mgpycte
    Napycte
    S(+6)pycte
    S(-2)pycte
    S(+2)pycte
    S(+3)pycte
    S(+4)pycte
    Sipycte
    Srpycte
    Hpycte
    Opycte
    chargebalancepycte
    chargebalance_negpycte
  /
  DATABASE pflotranDB.txt
  ACTIVITY_COEFFICIENTS OFF
  MOLAL
  OUTPUT
    Alpycte
    C(+4)pycte
    C(-4)pycte
    Capycte
    Clpycte
    Fe(+2)pycte
    Fe(+3)pycte
    Kpycte
    Mgpycte
    Napycte
    S(+6)pycte
    S(-2)pycte
    S(+2)pycte
    S(+3)pycte
    S(+4)pycte
    Sipycte
    Srpycte
    Hpycte
    Opycte
    chargebalancepycte
    chargebalance_negpycte
    TOTAL
  /
END
# == discretization (meshing of pycte : 15 + 35 + 10 + 30 cells, 10.3 m) ======
GRID
  TYPE STRUCTURED
  NXYZ 90 1 1
  DXYZ
    15*0.02d0 35*0.04285714285714286 10*0.1d0 30*0.25d0
    1.d0
    1.d0
  /
END
# == fluid properties =========================================================
FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 1e-09
END
# == material properties ======================================================
MATERIAL_PROPERTY cement
  ID 1
  POROSITY 0.13
  TORTUOSITY 0.0338
  LONGITUDINAL_DISPERSIVITY 0.d0
END
MATERIAL_PROPERTY clay
  ID 2
  POROSITY 0.18
  TORTUOSITY 0.144
  LONGITUDINAL_DISPERSIVITY 0.d0
END
# == output ===================================================================
OUTPUT
  TIMES y 1
  FORMAT HDF5
END
# == times (end time and output time rewritten by pycte at every coupling step) =
TIME
  FINAL_TIME 1 y
  INITIAL_TIMESTEP_SIZE 1.d-3 y
  MAXIMUM_TIMESTEP_SIZE 0.02 y
END
# == regions ==================================================================
REGION all
  COORDINATES
    -1.d20 -1.d20 -1.d20
    1.d20 1.d20 1.d20
  /
END
REGION cement
  BLOCK 1 15 1 1 1 1
END
REGION clay
  BLOCK 16 90 1 1 1 1
END
REGION east
  FACE EAST
  COORDINATES
    10.3d0 0.d0 0.d0
    10.3d0 1.d0 1.d0
  /
END
# == transport conditions =====================================================
TRANSPORT_CONDITION Initial
  TYPE DIRICHLET
  CONSTRAINT_LIST
    0.d0 Initial
  /
END
TRANSPORT_CONDITION east
  TYPE DIRICHLET
  CONSTRAINT_LIST
    0.d0 Clay
  /
END
# == couplers =================================================================
INITIAL_CONDITION Initial
  TRANSPORT_CONDITION Initial
  REGION all
END
BOUNDARY_CONDITION east
  TRANSPORT_CONDITION east
  REGION east
END
# == stratigraphy =============================================================
STRATA
  MATERIAL cement
  REGION cement
END
STRATA
  MATERIAL clay
  REGION clay
END
# == constraints : initial state written by pycte in testpycte.h5 (<name>i) ===
CONSTRAINT Initial
  CONCENTRATIONS
    Alpycte                 1.d-40 T DATASET ic001
    C(+4)pycte              1.d-40 T DATASET ic002
    C(-4)pycte              1.d-40 T DATASET ic003
    Capycte                 1.d-40 T DATASET ic004
    Clpycte                 1.d-40 T DATASET ic005
    Fe(+2)pycte             1.d-40 T DATASET ic006
    Fe(+3)pycte             1.d-40 T DATASET ic007
    Kpycte                  1.d-40 T DATASET ic008
    Mgpycte                 1.d-40 T DATASET ic009
    Napycte                 1.d-40 T DATASET ic010
    S(+6)pycte              1.d-40 T DATASET ic011
    S(-2)pycte              1.d-40 T DATASET ic012
    S(+2)pycte              1.d-40 T DATASET ic013
    S(+3)pycte              1.d-40 T DATASET ic014
    S(+4)pycte              1.d-40 T DATASET ic015
    Sipycte                 1.d-40 T DATASET ic016
    Srpycte                 1.d-40 T DATASET ic017
    Hpycte                  1.d-40 T DATASET ic018
    Opycte                  1.d-40 T DATASET ic019
    chargebalancepycte      1.d-40 T DATASET ic020
    chargebalance_negpycte  1.d-40 T DATASET ic021
  /
END
DATASET ic001
  HDF5_DATASET_NAME Ali
  FILENAME testpycte.h5
END
DATASET ic002
  HDF5_DATASET_NAME C(+4)i
  FILENAME testpycte.h5
END
DATASET ic003
  HDF5_DATASET_NAME C(-4)i
  FILENAME testpycte.h5
END
DATASET ic004
  HDF5_DATASET_NAME Cai
  FILENAME testpycte.h5
END
DATASET ic005
  HDF5_DATASET_NAME Cli
  FILENAME testpycte.h5
END
DATASET ic006
  HDF5_DATASET_NAME Fe(+2)i
  FILENAME testpycte.h5
END
DATASET ic007
  HDF5_DATASET_NAME Fe(+3)i
  FILENAME testpycte.h5
END
DATASET ic008
  HDF5_DATASET_NAME Ki
  FILENAME testpycte.h5
END
DATASET ic009
  HDF5_DATASET_NAME Mgi
  FILENAME testpycte.h5
END
DATASET ic010
  HDF5_DATASET_NAME Nai
  FILENAME testpycte.h5
END
DATASET ic011
  HDF5_DATASET_NAME S(+6)i
  FILENAME testpycte.h5
END
DATASET ic012
  HDF5_DATASET_NAME S(-2)i
  FILENAME testpycte.h5
END
DATASET ic013
  HDF5_DATASET_NAME S(+2)i
  FILENAME testpycte.h5
END
DATASET ic014
  HDF5_DATASET_NAME S(+3)i
  FILENAME testpycte.h5
END
DATASET ic015
  HDF5_DATASET_NAME S(+4)i
  FILENAME testpycte.h5
END
DATASET ic016
  HDF5_DATASET_NAME Sii
  FILENAME testpycte.h5
END
DATASET ic017
  HDF5_DATASET_NAME Sri
  FILENAME testpycte.h5
END
DATASET ic018
  HDF5_DATASET_NAME Hi
  FILENAME testpycte.h5
END
DATASET ic019
  HDF5_DATASET_NAME Oi
  FILENAME testpycte.h5
END
DATASET ic020
  HDF5_DATASET_NAME chargebalancei
  FILENAME testpycte.h5
END
DATASET ic021
  HDF5_DATASET_NAME chargebalance_negi
  FILENAME testpycte.h5
END
CONSTRAINT Clay
  CONCENTRATIONS
    Alpycte                 8.519998902e-08 T
    C(+4)pycte              0.0040527660588813574 T
    C(-4)pycte              3.36048e-17 T
    Capycte                 0.007713414966080056 T
    Clpycte                 0.041200000313349 T
    Fe(+2)pycte             6.11181766428239e-05 T
    Fe(+3)pycte             1.853659474032439e-09 T
    Kpycte                  0.0005109997648652 T
    Mgpycte                 0.00514973160860011 T
    Napycte                 0.04010000029724816 T
    S(+6)pycte              0.0111081534532578 T
    S(-2)pycte              1.2519090021629906e-10 T
    S(+2)pycte              5.8479432234234366e-15 T
    S(+3)pycte              2.841260640805699e-34 T
    S(+4)pycte              7.548770853000002e-15 T
    Sipycte                 0.00017999956704318576 T
    Srpycte                 0.0002521539815104087 T
    Hpycte                  111.0215997343147 T
    Opycte                  55.56547191826152 T
    chargebalancepycte      1e-40 T
    chargebalance_negpycte  2.21778e-08 T
  /
END
END_SUBSURFACE
