//********* The entities *******
// especes de phreeqc.dat pour Ca, Cl, K, N, Na, H, O, e- : log K a 25 C (expressions analytiques evaluees
// comme PHREEQC), parametres -gamma a b ; generees par make_chem.py
// especes maitresses (chaine entite -> espece d'origine, inchangee)
@species(Ca+2, 2, 5.0, 0.165)
@logKreaction(Ca+2, 0, 1.0, Ca)
@entity(N[+5], tot, 0)
@logKreaction(N[+5], 0, 1.0, N)
@species(NO3-, -1, 3.0, 0.0)
@logKreaction(NO3-, 0, 1.0, N[+5])
@entity(H[+1], tot, 0)
@logKreaction(H[+1], 0.0, 1.0, H)
@species(H+, 1, 9.0, 0.0)
@logKreaction(H+, 0.0, 1.0, H[+1])
@entity(O[-2], tot, 0)
@logKreaction(O[-2], 0.0, 1.0, O)
@entity(H2O, liter, 55.6)
@logKreaction(H2O, 0.0, 1.0, O[-2])
@species(Cl-, -1, 3.5, 0.015)
@logKreaction(Cl-, 0.0, 1.0, Cl)
@species(K+, 1, 3.5, 0.015)
@logKreaction(K+, 0, 1.0, K)
@species(Na+, 1, 4.0, 0.075)
@logKreaction(Na+, 0.0, 1.0, Na)
@entity(e-, diss, 0)
@logKreaction(e-, 0, 1.0, E)
// especes secondaires
@species(OH-, -1, 3.5, 0.0)
@logKreaction(OH-, -13.999530722624318, -1.0, H+, 1.0, H2O)
@species(O2, 0, 0, 0.1)
@logKreaction(O2, -86.08, -4.0, H+, 2.0, H2O, -4.0, e-)
@species(H2, 0, 0, 0.1)
@logKreaction(H2, -3.15, 2.0, H+, 2.0, e-)
@species(NO2-, -1, 3.0, 0.0)
@logKreaction(NO2-, 28.57, 2.0, H+, 1.0, NO3-, -1.0, H2O, 2.0, e-)
@species(N2, 0, 0, 0.1)
@logKreaction(N2, 207.08, 12.0, H+, 2.0, NO3-, -6.0, H2O, 10.0, e-)
@species(NH3, 0, 0, 0.1)
@logKreaction(NH3, 109.83278060519034, 9.0, H+, 1.0, NO3-, -3.0, H2O, 8.0, e-)
@species(NH4+, 1, 2.5, 0.0)
@logKreaction(NH4+, 119.077, 10.0, H+, 1.0, NO3-, -3.0, H2O, 8.0, e-)
@species(CaOH+, 1)
@logKreaction(CaOH+, -12.78, -1.0, H+, 1.0, Ca+2, 1.0, H2O)
@species(NaOH, 0, 0, 0.1)
@logKreaction(NaOH, -14.18, -1.0, H+, 1.0, Na+, 1.0, H2O)
@species(KOH, 0, 0, 0.1)
@logKreaction(KOH, -14.46, -1.0, H+, 1.0, K+, 1.0, H2O)

