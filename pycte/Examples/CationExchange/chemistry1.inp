//********* Extra text 2 *******
@class: extra_text_2(){
   @scan: objects2025.txt
// ---- alignement PHREEQC : classes de objects2025.txt redefinies avec des tolerances serrees ----
// (tol 1e-4 dans objects2025.txt : I, activite de l'eau, sites d'echange ; 1e-10 pour la charge ; 1e-13 bilans)
   @Class: set_ion_activity_model(name)
   {
      @globalVar: logI -2
      @Calc:(1, "I = 10^logI")
      @Var: I.eq 0
      @Calc: (3, "I.eq = (I /{I.calc})-1")
      @<name>(0.1)
      @solve: unknown:(name:, logI,  delta:, 1e-2, step: , .5,  iia:, true) equation:(name:, I.eq, tol:, 1e-13)
   }
   @Class: calculate_water_activity(){
      @Var: H2O_activity_equation 0
      @Calc:(5,"H2O_activity_equation = H2O.logact - log10(1 - 0.017 * min(20, sumAqIons))" )
      @solve: unknown:(name:, H2O.logact,  delta:, 1e-3, type:, lin, step: , .1, reldelta:, 1e-3) equation:(name:, H2O_activity_equation, tol: , 1e-14 )
   }
   @class: surfsite(model, name, density, coef){
      @Var: <model>_<name>.logk_unit 0
      @Calc:(1, "<model>_<name>.logk_unit = 0")
      @phase(<model>_<name>, <model>, <density>)
      @entity(<model>_<name>, <model>_<name>, <coef>)
      @solve: unknown:(name:, <model>_<name>.logact,  delta:, 1e-6, type:, lin, step: , .1, default:, -1) equation:(name:, <model>_<name>.<model>_<name>, tol: , 1e-14, default:, 1)
   }
   @Class: primary_entity(name, unknownvalue, phase, equationvalue){
        @globalvar: <name>.logact <unknownvalue>
        @globalvar: <name>.<phase> <equationvalue>
        @solve: unknown:(name:, <name>.logact,  delta:, 1e-6, type:, lin, step: , 1, default:, <unknownvalue>) equation:(name:, <name>.<phase>, tol: , 1e-16, default:, <equationvalue>) )
   }
   @class: calculate_rho_sat(){
      @Var: DH_A 0.5100247894269
      @Var: DH_B 32849063.3992
      @Calc:(1, "DH_A = 0.5100247894269")
      @Calc:(1, "DH_B = 32849063.3992")
   }
   @Class: balance_charge(unknown)
   {
      @GlobalVar: chargebalance 0
      @Calc: (1, "chargebalance = 0")
      @solve: unknown:(name:, <unknown>,  delta:, 1e-6, type:, lin, step: , .1,iia:, true) equation:(name:, chargebalance, tol: , 1e-16, default:, 0)
   }
}
@extra_text_2()
//********* End of extra text 2 *******

@globalvar: I .1
@davies()
@calculate_water_activity()

//********* The primary entities *******

@entity(Ca, tot, 0)
@primary_entity(Ca, -9.0, tot, 1.0E-9)
@entity(Cl, tot, 0)
@primary_entity(Cl, -9.0, tot, 1.0E-9)
@Global: pe
@Calc:(1, "E.logact = -pe")
@entity(E, tot, 0)
@primary_entity(E, pe, 12.5)     // pe impose 12.5 = Fix_pe -12.5 O2 de ref.pqi
@Global: pH
@Calc:(1, "H.logact = -pH")
@entity(H, tot, 0)
@primary_entity(H, pH, 7.0)
@entity(K, tot, 0)
@primary_entity(K, -9.0, tot, 1.0E-9)
@entity(N, tot, 0)
@primary_entity(N, -9.0, tot, 1.0E-9)
@entity(Na, tot, 0)
@primary_entity(Na, -3.0)     // Na libre : ajuste par @balance_charge (tampon NaOH)
@Global: H2O.logact
@Calc:(1, "O.logact = H2O.logact")
@entity(O, tot, 0)
@primary_entity(O, H2O.logact, -0.0)
// pH impose (H) et electroneutralite par Na = Fix_H+ -7 NaOH de ref.pqi
@balance_charge(Na.logact)
