//********* Adsorption Model Exch *******************
//**** Model specific text **** 
@class: adsorptionmodeltext(Exch){

//The PHREEQC definition for comparison

EXCHANGE_MASTER_SPECIES
 Exch  Exch-


EXCHANGE_SPECIES
Exch- = Exch- ; log_k 0

EXCHANGE_SPECIES
Exch- + Na+ = ExchNa
     log_k  0

2 ExchNa + UO2+2 = Exch2UO2 + 2 Na+
     log_k  0.45
}
//**** End of model specific text **** 

//**** Model type code **** 
@class: adsorptionmodelcode(Basic_surface){
   @class: Basic_surface(name, parent_phase ,concentration){
      // The Basic surface model just contains of a single phase
      // that is linked to its parent phase via its concentration
      @phase(<name>, <parent_phase>, <concentration>)
   }
}
@adsorptionmodelcode(Basic_surface)
//**** End of model type code **** 

// CEC par kg d'eau de ref.txt (0.0011 mol de sites de ref.pqi / masse d'eau PHREEQC)
@adsmodel(Exch, ads ,0.0011000000003130637, Basic_surface)
@surfsite(Exch, X, 1, 0)
// Gaines-Thomas comme PHREEQC : a_i = gamma_i * beta_i, beta_i = nu_i n_i / CEC ; gamma_i (WATEQ, charge nu_i,
// -gamma a b de EXCHANGE_SPECIES) passe dans le log K : log K - log gamma_i ; coef 1/nu_i -> fraction de sites
// pas de X-H : absent de phreeqc.dat
@surfspecies(Exch, X, X-Na, 1.0)
@logKreaction(Exch_X-Na, "(0.0 + Truesdell_A * 1.0 * sqrt(I) / (1 + Truesdell_B * 4.0 * sqrt(I)) - 0.075 * I)", 1.0, Na+, 1.0, Exch_X)
@surfspecies(Exch, X, X-K, 1.0)
@logKreaction(Exch_X-K, "(0.7 + Truesdell_A * 1.0 * sqrt(I) / (1 + Truesdell_B * 3.5 * sqrt(I)) - 0.015 * I)", 1.0, K+, 1.0, Exch_X)
@surfspecies(Exch, X, X2-Ca, 0.5)
@logKreaction(Exch_X2-Ca, "(0.8 + Truesdell_A * 4.0 * sqrt(I) / (1 + Truesdell_B * 5.0 * sqrt(I)) - 0.165 * I)", 1.0, Ca+2, 2.0, Exch_X)
@surfspecies(Exch, X, X-NH4, 1.0)
@logKreaction(Exch_X-NH4, "(0.5999999999999943 + Truesdell_A * 1.0 * sqrt(I) / (1 + Truesdell_B * 2.5 * sqrt(I)) - 0.0 * I)", 1.0, NH4+, 1.0, Exch_X)
//********* End of Adsorption Model Exch *************

//********* End of Adsorption Models *******
